# Required for the core API
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
GEMINI_API_KEY=replace-with-gemini-key

# Required for scheme recommendations / RAG
# Get these from Supabase Dashboard -> Settings -> API. Use `service_role`, not `anon`.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional integrations
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agriassist
HUGGINGFACE_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@agriassist.app
